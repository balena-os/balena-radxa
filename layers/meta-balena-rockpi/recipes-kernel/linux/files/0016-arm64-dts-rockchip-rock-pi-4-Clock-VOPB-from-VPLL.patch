From f534419dddb10201f565a8ec5c56163f36d4e447 Mon Sep 17 00:00:00 2001
From: Guillermo Vega <guillermo.vega@balena.io>
Date: Thu, 12 Nov 2026 08:26:20 +0100
Subject: [PATCH 16/16] arm64: dts: rockchip: rock-pi-4: Clock VOPB from VPLL

The HDMI driver sets VPLL to the pixel clock of the mode, but the
VOPB dot clock (DCLK_VOP0_DIV) can be left on GPLL or CPLL by the boot
loader. Assign VPLL as its parent so the VOP uses the rate HDMI sets.

The assigned-clocks of the SoC node are repeated, because the board
property replaces them.

Upstream-Status: Pending
Signed-off-by: Guillermo Vega <guillermo.vega@balena.io>
---
 arch/arm64/boot/dts/rockchip/rk3399-rock-pi-4.dtsi | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3399-rock-pi-4.dtsi b/arch/arm64/boot/dts/rockchip/rk3399-rock-pi-4.dtsi
index f2279aa..a0c0db4 100644
--- a/arch/arm64/boot/dts/rockchip/rk3399-rock-pi-4.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3399-rock-pi-4.dtsi
@@ -775,6 +775,10 @@
 };
 
 &vopb {
+	assigned-clocks = <&cru ACLK_VOP0>, <&cru HCLK_VOP0>,
+			  <&cru DCLK_VOP0_DIV>;
+	assigned-clock-rates = <400000000>, <100000000>, <0>;
+	assigned-clock-parents = <0>, <0>, <&cru PLL_VPLL>;
 	status = "okay";
 };
 
